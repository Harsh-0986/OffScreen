# ---- AI ----
# Never expose this to the frontend. Backend only.
GEMINI_API_KEY=
# Change only this value if a different Gemma 4 model is available.
GEMMA_MODEL=gemma-4-26b-a4b-it
# Set to "two_stage" to compare the separate describe/judge calls against the
# default single multimodal call (SPEC §43).
DISCOVERY_PIPELINE=combined

# ---- Auth ----
# Signs session tokens. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me

# ---- App ----
APP_ENV=development
DATABASE_URL=sqlite:///./outside.db
UPLOAD_DIR=uploads
MAX_IMAGE_BYTES=10485760

# ---- CORS (frontend origins, comma separated) ----
CORS_ORIGINS=http://localhost:3000

# NOTE: frontend configuration does NOT live here.
# Next.js only reads env files from frontend/, so set the API URL in
# frontend/.env.local — see frontend/.env.example.
