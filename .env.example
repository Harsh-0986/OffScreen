# ---- AI ----
# Never expose this to the frontend. Backend only.
GEMINI_API_KEY=
# Change only this value if a different Gemma 4 model is available.
GEMMA_MODEL=gemma-4-26b-a4b-it

# ---- Auth ----
# Signs session tokens. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me

# ---- App ----
APP_ENV=development
DATABASE_URL=sqlite:///./outside.db
UPLOAD_DIR=uploads
MAX_IMAGE_BYTES=10485760

# ---- CORS (frontend origins, comma separated) ----
CORS_ORIGINS=http://localhost:3000
